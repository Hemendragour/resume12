+                  : formatMonthYear(project.endDate)}
+              </p>
+            </div>
+
+            {project.description && (
+              <ul
+                className={`
+                  ${T.list.bullet}
+                  ${T.spacing.itemHeader}
+                  ${T.spacing.bullet}
+                  ${T.fontSize.body}
+                  ${T.lineHeight.body}
+                  ${T.colors.body}
+                `}
+              >
+                {project.description
+                  .filter((line) => line.trim() !== "")
+                  .map((line, index) => (
+                    <li key={index}>{line.replace(/^•\s*/, "")}</li>
+                  ))}
+              </ul>
+            )}
+          </div>
+        ))}
+      </div>
+    </section>
+  );
+}
