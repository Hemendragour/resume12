+                  `}
+                >
+                  {item.title}
+                </h3>
+
+                {item.subtitle && (
+                  <p
+                    className={`
+                      ${T.fontSize.itemSubtitle}
+                      italic
+                      ${T.colors.body}
+                    `}
+                  >
+                    {item.subtitle}
+                  </p>
+                )}
+              </div>
+
+              {(item.startDate || item.endDate) && (
+                <p
+                  className={`
+                    ${T.fontSize.date}
+                    ${T.colors.muted}
+                  `}
+                >
+                  {formatMonthYear(item.startDate)}
+                  {item.startDate && item.endDate ? " - " : ""}
+                  {formatMonthYear(item.endDate)}
+                </p>
+              )}
+            </div>
+
+            {item.description && (
+              <p
+                className={`
+                  ${T.spacing.itemHeader}
+                  ${T.fontSize.body}
+                  ${T.lineHeight.body}
+                  ${T.colors.body}
+                  whitespace-pre-line
